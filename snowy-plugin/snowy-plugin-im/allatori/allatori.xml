<config>
    <!-- Maven properties could be used in Allatori configuration file. -->
    <input>
        <jar in="snowy-plugin-im-3.0.0.jar" out="snowy-plugin-im-3.0.0.jar"/>
    </input>

    <keep-names>
        <class access="protected+">
            <field access="protected+"/>
            <method access="protected+"/>
        </class>
    </keep-names>
    <ignore-classes>
        <class template="class vip.xiaonuo.im.modular.*"/>
    </ignore-classes>
    <property name="log-file" value="log.xml"/>
</config>
