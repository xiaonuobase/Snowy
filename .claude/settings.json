{
  "permissions": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PROJECT_DIR}/.agents/hooks/skill-forced-eval.js\" && node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/skill-forced-eval.js\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PROJECT_DIR}/.agents/hooks/pre-tool-use.js\" && node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/pre-tool-use.js\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PROJECT_DIR}/.agents/hooks/stop.js\" && node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/stop.js\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "mcpServers": {}
}
